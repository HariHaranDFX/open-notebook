# Open Notebook Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Change this to any secret string (minimum 16 characters recommended)
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
# root:root is fine for local use. Change these before exposing the instance to a
# network — docker-compose.yml reads them for both the SurrealDB server and the
# app, so the two stay in sync.
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# You can configure these via the UI (Settings → API Keys) or set them here
# UI configuration is recommended for better security and flexibility

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# Deployment-level identity. Must be an absolute path to a trusted JSON file.
# The file is validated and cached when the frontend process starts; restart the
# frontend after changing it. Docker Compose uses /app/config/brand.json instead.
# BRAND_CONFIG_PATH=/absolute/path/to/brand.json

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint (if running locally)
# OLLAMA_API_BASE=http://localhost:11434

# oMLX (Apple Silicon) — prefer Settings → API Keys; port 11435 avoids SurrealDB on 8000
# OMLX_API_BASE=http://localhost:11435/v1
# OMLX_API_KEY=  # optional; only if oMLX was started with --api-key

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Remote Crawl4AI server for the crawl4ai URL engine (no local install needed).
# Crawl4AI Docker >= 0.9.0 requires a bearer token for external connections.
# CRAWL4AI_API_URL=http://crawl4ai:11235
# CRAWL4AI_API_TOKEN=your-crawl4ai-token

# Max background tasks the worker runs concurrently (default 5). Set to 1 for
# sequential processing on single-GPU / local-LLM setups to avoid rate limits.
# NOTE: consumed at worker launch, not by the app — for `make`/dev-init export
# it in your shell; for Docker set it under `environment:` in docker-compose.yml.
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=1

# Maximum upload/request body size in MB (default: 100). Raise this if you
# need to upload larger audio/video files. A fronting reverse proxy's own
# limit (e.g. nginx client_max_body_size) still applies and should be raised
# to match.
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=100

# Original uploaded-file storage. The default keeps files under DATA_FOLDER/uploads.
# OPEN_NOTEBOOK_ORIGINAL_FILE_STORE=filesystem

# SharePoint Embedded original storage (app-only; separate from the inbound
# SharePoint connector). The container must already exist and the application
# must have FileStorageContainer.Selected plus access to that container.
# OPEN_NOTEBOOK_ORIGINAL_FILE_STORE=sharepoint_embedded
# SHAREPOINT_STORAGE_TENANT_ID=00000000-0000-0000-0000-000000000000
# SHAREPOINT_STORAGE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SHAREPOINT_STORAGE_CLIENT_SECRET=replace-with-a-secret-value
# SHAREPOINT_STORAGE_PROFILE_ID=default
# SHAREPOINT_STORAGE_PROFILES_FILE=
# SHAREPOINT_STORAGE_CERTIFICATE_PFX_PATH=/run/secrets/storage.pfx
# SHAREPOINT_STORAGE_CERTIFICATE_PASSPHRASE=
# SHAREPOINT_STORAGE_CONTAINER_ID=replace-with-the-container-id
# Pull deployments require a digest. Local builds ignore this and use docker-compose.local.yml.
# OPEN_NOTEBOOK_IMAGE_REF=datafabricx/open-notebook-commercial@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# OPTIONAL: Authentication (see docs/AUTH.md)
# =============================================================================
# Default is password mode. Leave OPEN_NOTEBOOK_PASSWORD unset to disable auth
# (local/dev only). For Microsoft Entra ID, set AUTH_PROVIDER=entra and the
# ENTRA_* / AUTH_ADMIN_EMAILS values below.

# AUTH_PROVIDER=password
# OPEN_NOTEBOOK_PASSWORD=your-secure-password

# Stable deployment id stamped on ownership records (not ENTRA_CLIENT_ID).
# CLIENT_ID=local

# --- Microsoft Entra ID (AUTH_PROVIDER=entra) ---
# AUTH_PROVIDER=entra
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=replace-with-a-secret-value
# Public callback must match the Entra app registration (frontend origin).
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Separate delegated SharePoint connector callback on the public API origin.
# Register this exact URI in the same Entra app as a Web redirect URI.
# Requires delegated Sites.Read.All consent and OPEN_NOTEBOOK_ENCRYPTION_KEY.
# SHAREPOINT_CONNECTOR_REDIRECT_URI=http://localhost:3000/api/connectors/sharepoint/callback
# AUTH_ADMIN_EMAILS=admin@example.com
# AUTH_SESSION_HOURS=8
# Optional: force account picker / re-login. Microsoft values:
# select_account | login | consent | none. Leave unset for SSO default.
# ENTRA_PROMPT=select_account
# Force cookie Secure flag: true/false. Leave unset to auto-detect from
# X-Forwarded-Proto. Use false only for local HTTP.
# AUTH_COOKIE_SECURE=false
# Required for Entra browser writes (CSRF Origin allowlist). Comma-separated.
# CORS_ORIGINS=http://localhost:3000

# --- Entra group sync + directory picker (WBS 4.20 / 4.21) ---
# Both features are OFF by default. The sync runs in the API lifespan and
# needs the Entra app registration to hold `GroupMember.Read.All`
# (Application) with admin consent. The directory picker additionally
# needs `User.Read.All` (Application) with admin consent to typeahead
# and JIT-stub tenant users. See docs/AUTH.md.
# ENTRA_GROUP_SYNC_ENABLED=false
# How often the sync loop diffs Entra membership against local. Default
# 15 minutes; lower values raise Graph pressure. Range floored at 1s
# only to keep tests fast.
# ENTRA_GROUP_SYNC_INTERVAL_MINUTES=15

# Network / Proxy (corporate / firewalled environments)
# Route outbound HTTP(S) through a proxy. NO_PROXY MUST list the internal
# SurrealDB hosts (host.docker.internal, surrealdb) — otherwise the DB
# websocket gets tunnelled through the proxy and the worker/API fail to start
# with HTTP 403. The app also injects these hosts automatically as a safety
# net, but keep them here so your config is explicit.
# HTTP_PROXY=http://proxy.corp.com:8080
# HTTPS_PROXY=http://proxy.corp.com:8080
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,surrealdb,.local

# For more configuration options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md
