-- Delegated external connectors are independent of login sessions and file storage.
DEFINE TABLE IF NOT EXISTS connector_connection SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS user_id ON TABLE connector_connection TYPE record<user>;
DEFINE FIELD IF NOT EXISTS provider ON TABLE connector_connection TYPE string;
DEFINE FIELD IF NOT EXISTS refresh_token ON TABLE connector_connection TYPE option<string>;
DEFINE FIELD IF NOT EXISTS granted_scopes ON TABLE connector_connection TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS external_tenant_id ON TABLE connector_connection TYPE option<string>;
DEFINE FIELD IF NOT EXISTS external_account_id ON TABLE connector_connection TYPE option<string>;
DEFINE FIELD IF NOT EXISTS status ON TABLE connector_connection TYPE string DEFAULT 'connected';
DEFINE FIELD IF NOT EXISTS connected_at ON TABLE connector_connection TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS disconnected_at ON TABLE connector_connection TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS created ON TABLE connector_connection TYPE datetime DEFAULT time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE connector_connection TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS connector_connection_owner ON TABLE connector_connection FIELDS user_id, provider UNIQUE;

DEFINE TABLE IF NOT EXISTS connector_oauth_state SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS user_id ON TABLE connector_oauth_state TYPE record<user>;
DEFINE FIELD IF NOT EXISTS state_hash ON TABLE connector_oauth_state TYPE string;
DEFINE FIELD IF NOT EXISTS code_verifier ON TABLE connector_oauth_state TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE connector_oauth_state TYPE datetime;
DEFINE FIELD IF NOT EXISTS created ON TABLE connector_oauth_state TYPE datetime DEFAULT time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE connector_oauth_state TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS connector_oauth_state_owner ON TABLE connector_oauth_state FIELDS user_id;
DEFINE INDEX IF NOT EXISTS connector_oauth_state_hash ON TABLE connector_oauth_state FIELDS state_hash UNIQUE;

DEFINE TABLE IF NOT EXISTS connector_batch SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS user_id ON TABLE connector_batch TYPE record<user>;
DEFINE FIELD IF NOT EXISTS connection_id ON TABLE connector_batch TYPE record<connector_connection>;
DEFINE FIELD IF NOT EXISTS drive_id ON TABLE connector_batch TYPE string;
DEFINE FIELD IF NOT EXISTS folder_id ON TABLE connector_batch TYPE option<string>;
DEFINE FIELD IF NOT EXISTS item_ids ON TABLE connector_batch TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS notebook_ids ON TABLE connector_batch TYPE array<record<notebook>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS transformations ON TABLE connector_batch TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS embed ON TABLE connector_batch TYPE bool DEFAULT true;
DEFINE FIELD IF NOT EXISTS status ON TABLE connector_batch TYPE string DEFAULT 'pending';
DEFINE FIELD IF NOT EXISTS total ON TABLE connector_batch TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS completed ON TABLE connector_batch TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS failed ON TABLE connector_batch TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS command_id ON TABLE connector_batch TYPE option<string>;
DEFINE FIELD IF NOT EXISTS error ON TABLE connector_batch TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created ON TABLE connector_batch DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE connector_batch DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS connector_batch_owner ON TABLE connector_batch FIELDS user_id;

DEFINE TABLE IF NOT EXISTS connector_batch_document SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS user_id ON TABLE connector_batch_document TYPE record<user>;
DEFINE FIELD IF NOT EXISTS batch_id ON TABLE connector_batch_document TYPE record<connector_batch>;
DEFINE FIELD IF NOT EXISTS drive_id ON TABLE connector_batch_document TYPE string;
DEFINE FIELD IF NOT EXISTS item_id ON TABLE connector_batch_document TYPE string;
DEFINE FIELD IF NOT EXISTS name ON TABLE connector_batch_document TYPE string;
DEFINE FIELD IF NOT EXISTS etag ON TABLE connector_batch_document TYPE option<string>;
DEFINE FIELD IF NOT EXISTS source_id ON TABLE connector_batch_document TYPE option<record<source>>;
DEFINE FIELD IF NOT EXISTS command_id ON TABLE connector_batch_document TYPE option<string>;
DEFINE FIELD IF NOT EXISTS status ON TABLE connector_batch_document TYPE string DEFAULT 'pending';
DEFINE FIELD IF NOT EXISTS error ON TABLE connector_batch_document TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created ON TABLE connector_batch_document DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE connector_batch_document DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS connector_batch_document_owner ON TABLE connector_batch_document FIELDS user_id, batch_id;
DEFINE INDEX IF NOT EXISTS connector_batch_document_item ON TABLE connector_batch_document FIELDS batch_id, drive_id, item_id UNIQUE;
